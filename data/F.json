ding information about our management team, brands, products, services, and corporate governance principles.","zh":null},{"en":"The corporate governance information on our website includes our Corporate Governance Principles, Code of Ethics for Senior Financial Personnel, Code of Ethics for the Board of Directors, Code of Corporate Conduct for all employees, and the Charters for each of the Committees of our Board of Directors. In addition, any amendments to our Code of Ethics or waivers granted to our directors and executive officers will be posted on our corporate website. All of these documents may be accessed by going to our corporate website, or may be obtained free of charge by writing to our Shareholder Relations Department, Ford Motor Company, One American Road, P.O. Box 1899, Dearborn, Michigan 48126-1899.","zh":null}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2025-12-31","items":[{"name":"Company Excluding Ford Credit","val":173996000000,"zh":"Company Excluding Ford Credit"},{"name":"Ford Blue","val":101019000000,"zh":"Ford Blue"},{"name":"Ford Pro","val":66286000000,"zh":"Ford Pro"},{"name":"Ford Credit","val":13271000000,"zh":"Ford Credit"},{"name":"Ford Model E","val":6670000000,"zh":"Ford Model E"}],"total":187267000000},"prod":{"end":"2025-12-31","items":[{"name":"All Sales Type Products & Services","val":173749000000,"zh":"All Sales Type Products & Services"},{"name":"Vehicles Parts & Accessories","val":167310000000,"zh":"Vehicles Parts & Accessories"},{"name":"Financingincome","val":8211000000,"zh":"Financingincome"},{"name":"Leasingincome","val":5143000000,"zh":"Leasingincome"},{"name":"Service & Other Revenue","val":3586000000,"zh":"Service & Other Revenue"},{"name":"Sale Of Used Vehicles","val":2853000000,"zh":"Sale Of Used Vehicles"},{"name":"Insuranceincome","val":164000000,"zh":"Insuranceincome"}],"total":187267000000},"geo":{"end":"2025-12-31","items":[{"name":"US","val":122574000000,"zh":"美國"},{"name":"Other Geog