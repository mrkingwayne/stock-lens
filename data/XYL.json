R1NQWVpuTEV3SmJsVEJrNFpOanZCczJUOWNDYW5fOHdjaEx5ZHdfcS15TmFfMmlxWTRYZ0JPbmFiSGNEc1I5SXBZcUpUOVoyOE9k?oc=5","date":"2026-10-27","zh":"為什麼賽萊默股價週二下跌？ - 賽萊默（NYSE：XYL）"}],"themes":[{"name":"財報","count":5},{"name":"訂單/合約","count":2},{"name":"股票回購/股利","count":2}],"biz":{"tenk":{"form":"10-K","date":"2026-02-25","period":"2025-12-31","url":"https://www.sec.gov/Archives/edgar/data/1524472/000152447226000012/xyl-20251231.htm"},"overview":[{"en":"Xylem is a leading global water technology company with 2025 revenues of $9.0 billion and approximately 22,000 employees worldwide. We design, manufacture and service engineered products and solutions across a wide variety of critical applications, primarily in the water sector. Our broad portfolio of products, services and solutions addresses customer needs of scarcity, resilience, quality, and affordability across the water cycle, from the delivery, treatment, measurement and use of drinking water, to the collection, testing, analysis and treatment of wastewater, to the return of water to the environment.","zh":"Xylem 是一家全球領先的水技術公司，2025 年收入達 90 億美元，在全球擁有約 22,000 名員工。我們為各種關鍵應用（主要是水務領域）設計、製造和維修工程產品和解決方案。我們廣泛的產品、服務和解決方案組合可滿足客戶在整個水循環中的稀缺性、彈性、品質和可負擔性的需求，從飲用水的輸送、處理、測量和使用，到廢水的收集、測試、分析和處理，再到水返回環境。"},{"en":"We have differentiated market positions in core applications including transport and dewatering, process water and wastewater treatment, analytics, smart metering, digital software solutions and comprehensive services. Setting us apart is a unique set of global assets that include:","zh":"我們在運輸和脫水、製程水和廢水處理、分析、智慧計量、數位軟體解決方案和綜合服務等核心應用領域擁有差異化的市場地位。讓我們與眾不同的是一系列獨特的全球資產，其中包括："},{"en":"Global distribution networks consisting of direct sales forces and independent channel partners serving a diverse customer base in approximately 150 countries","zh":"由直銷隊伍和獨立通路合作夥伴組成的全球分銷網路，為約 150 個國家的多元化客戶群提供服務"}],"markets":[{"en":"Through two closely linked applications, transport and treatment, our Water Infrastructure segment primarily supports the process that collects water from a source, treats it and distributes it to users, and then treats and returns the wastewater responsibly to the environment.","zh":"透過運輸和處理這兩個緊密相連的應用，我們的水基礎設施部門主要支援從水源收集水、處理水並將其分配給使用者的過程，然後負責任地處理廢水並將其返回環境。"},{"en":"The customer base consists of two primary end markets: utility and industrial. The utility market includes public, private and public-private entities that support water, wastewater and storm water networks. The industrial market includes customers that require similar water and wastewater infrastructure applications to support various industrial operations.","zh":"客戶群包括兩個主要終端市場：公用事業和工業。公用事業市場包括支持供水、廢水和雨水網路的公共、私營和公共和私人實體。工業市場包括需要類似的水和廢水基礎設施應用來支援各種工業運作的客戶。"}],"customers":[{"en":"Our business is not dependent on any single customer or a few customers, the loss of which would have a material adverse effect on our Company. No individual customer accounted for more than 5% of our consolidated revenues in 2025, 2024 or 2023.","zh":"我們的業務不依賴任何單一客戶或少數客戶，其損失將對我們公司產生重大不利影響。 2025 年、2024 年或 2023 年，沒有任何個人客戶占我們合併收入的 5% 以上。"},{"en":"Backlog includes orders on hand as well as contractual customer agreements at the end of the period. Delivery schedules vary from customer to customer based on their requirements. Annual or multi-year contracts are subject to rescheduling and cancellation by customers due to the long-term nature of the contracts. As such, beginning total backlog, plus orders, minus revenues, will not equal ending total backlog due to contract adjustments, foreign currency fluctuations and other factors. Typically, capital projects require longer lead production cycles and deployment schedules, and delays occur from time to time. Total backlog was $4,615 million at December 31, 2025","zh":"積壓訂單包括現有訂單以及期末的客戶合約協議。交貨時間表因客戶的要求而異。由於合約的長期性質，年度或多年合約可能會被客戶重新安排和取消。因此，由於合約調整、外匯波動和其他因素，期初總積壓訂單加上訂單減去收入並不等於期末總積壓訂單。通常，資本項目需要更長的生產週期和部署計劃，有時會發生延遲。截至 2025 年 12 月 31 日，積壓訂單總額為 46.15 億美元"}],"competition":[],"segments":{"seg":{"end":"2025-12-31","items":[{"name":"Water Infrastructure","val":2636000000,"zh":"水務基礎設施"},{"name":"Water Solutions Services","val":2464000000,"zh":"水解決方案服務部門"},{"name":"Measurementand Control Solutions","val":2086000000,"zh":"測量和控制解決方案"},{"name":"Applied Water","val":1849000000,"zh":"應用水"}],"total":9035000000},"prod":{"end":"2025-12-31","items":[{"name":"Product","val":7472000000,"zh":"產品"},{"name":"Service","val":1563000000,"zh":"服務"}],"total":9035000000},"geo":{"end":"2025-12-31","items":[{"name":"US","val":5209000000,"zh":"美國"},{"name":"Europe","val":1839000000,"zh":"歐洲"},{"name":"Asia Pacific","val":1221000000,"zh":"亞太"},{"name":"Other Countries","val":766000000,"zh":"其他國家"}],"total":9035000000}},"peers":["PNR","IEX","AWK","ROP","AME"]}}