/CBMiogFBVV95cUxOeTRUSDVuREhUeHlCX2JKbUNQTWpyakMxTXVBbkVIUlZIZmV2Wnhza2JsWWRGVkdTSU8yTk1IY1hpcmRFTUpxSGVxMENHalZKY0g5RXZrdUk5QXNNb1V6MlFRaTJHSFJHcVhOVmZienQzbnJ5VktHMUJOem85SzJzRW9UQXEtZTlubWNMTWFNcUlhdDhkRnBTdVFQWGlIUk54eXc?oc=5","date":"2026-11-10","zh":"Coinbase Global (COIN) 重新獲得新澤西州質押准入意味著什麼？"},{"title":"Today's Crypto News: Bitcoin, Ether and Altcoin Insights","src":"Investing News Network","url":"https://news.google.com/rss/articles/CBMiZEFVX3lxTE9PU3pBdGY0NWJMSWFUTFRDUGx3RklNQlNENWdlQjBiNG9meUo5andqSHFER0lkNlhEaFVwOXpLYWZseVJ1YVZsU2Q4RzBWT1RoeUhTM19YaFljM2ZHcm5yMHYxTlc?oc=5","date":"2026-11-09","zh":"今日加密貨幣新聞：比特幣、以太幣和山寨幣見解"}],"themes":[{"name":"分析師評等","count":3},{"name":"加密貨幣","count":2},{"name":"財報","count":1}],"biz":{"tenk":{"form":"10-K","date":"2026-02-12","period":"2025-12-31","url":"https://www.sec.gov/Archives/edgar/data/1679788/000167978826000015/coin-20251231.htm"},"overview":[{"en":"We are working to update the century-old financial system by providing a trusted platform that makes it easy for our customers to engage with crypto assets. In December 2025, we took a major step forward to becoming the Everything Exchange—dramatically expanding the assets available to trade on Coinbase, including stocks, commodity futures, perpetual futures, and prediction markets. Our goal is to create a comprehensive, seamless experience for retail users, institutions, and developers to engage in the future of finance.","zh":null},{"en":"Consumers: Retail customers seeking to hold, invest or trade crypto assets, as well as a growing set of trading offerings such as equities, prediction markets, and derivatives. Consumers use Coinbase as a primary account for crypto-enabled financial services, and to engage onchain.","zh":null},{"en":"Institutions: Businesses including market makers, asset managers, hedge funds, banks, wealth platforms, registered investment advisors, payment platforms, and public and private corporations. These customers use our products to custody and trade crypto or crypto derivatives.","zh":null}],"markets":[],"customers":[{"en":"We provide an onchain staking service, which allows our customers to stake their assets with a few clicks. Our customers maintain full ownership of their crypto assets while earning staking rewards. Customers who stake their assets receive rewards, paid out by applicable blockchain protocols, in the form of the network's crypto asset. The rewards rates, expressed as an annual percentage yield, vary by asset. In return for the services we provide, we earn a fixed percentage commission on all staking rewards received.","zh":null}],"competition":[{"en":"The crypto industry is highly innovative, rapidly evolving, and characterized by healthy competition, experimentation, changing customer needs, frequent introductions of new products and services, and is subject to uncertain and evolving industry and regulatory requirements. We face significant competition from a variety of companies around the world—ranging from crypto-native companies, including decentralized exchanges, to large traditional financial services incumbents and financial technology providers.","zh":null},{"en":"traditional financial services and financial technology companies. This includes companies that offer crypto powered products, as well as companies that only offer traditional products, such as stocks. With the expansion in our product offerings in 2025 to include stocks, prediction markets and more, our competitive set in this category has broadened;","zh":null}],"segments":{"prod":{"end":"2025-12-31","items":[{"name":"Bank Servicing & Subscription & Circulation","val":6883438000,"zh":"Bank Servicing & Subscription & Circulation"},{"name":"Bank Servicing","val":4055390000,"zh":"Bank Servicing"},{"name":"Bank Servicing Consumer Net","val":3322835000,"zh":"Bank Servicing Consumer Net"},{"name":"Subscription & Circulation","val":2828048000,"zh":"Subscription & Circulation"},{"name":"Subscription & Circulation Stablecoin","val":1348821000,"zh":"Subscription & Circulation Stablecoin"},{"name":"Subscription & Circulation Blockchain Infrastructure Service","val":677405000,"zh":"Subscription & Circulation Blockchain Infrastructure Service"},{"name":"Subscription & Circulation Other","val":554775000,"zh":"Subscription & Circulation Other"},{"name":"Bank Servicing Institutional","val":479667000,"zh":"Bank Servicing Institutional"},{"name":"Other Revenue","val":297887000,"zh":"Other Revenue"},{"name":"Bank Servicing Other","val":252888000,"zh":"Bank Servicing Other"}],"total":7181325000},"geo":{"end":"2025-12-31","items":[{"name":"US","val":6010607000,"zh":"美國"},{"name":"Non Us","val":1170718000,"zh":"Non Us"}],"total":7181325000}},"peers":["HOOD","MSTR","PLTR","RBLX","SOFI"]}}