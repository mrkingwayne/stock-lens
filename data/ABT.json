d to enable Abbott to enter the cancer diagnostics market. The acquisition is subject to customary closing conditions, including the approval of Exact Sciences shareholders and obtaining the required regulatory clearances.","zh":null},{"en":"These products include a broad line of branded generic pharmaceuticals manufactured worldwide and marketed and sold outside the United States in emerging markets. These products are generally sold directly to wholesalers, distributors, government agencies, healthcare facilities, pharmacies, and independent retailers from Abbott-owned distribution centers or public warehouses, depending on the market served. Certain products are co-marketed or co-promoted with, or licensed from, other companies.","zh":null}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2025-12-31","items":[{"name":"Medical Devices","val":21387000000,"zh":"Medical Devices"},{"name":"Diagnostic Products","val":8937000000,"zh":"Diagnostic Products"},{"name":"Nutritional Products","val":8451000000,"zh":"Nutritional Products"},{"name":"Established Pharmaceutical Products","val":5536000000,"zh":"Established Pharmaceutical Products"}],"total":44328000000},"geo":{"end":"2025-12-31","items":[{"name":"Non Us","val":27202000000,"zh":"Non Us"},{"name":"US","val":17126000000,"zh":"美國"},{"name":"All Other Countries","val":15979000000,"zh":"All Other Countries"},{"name":"DE","val":2759000000,"zh":"德國"},{"name":"CN","val":1907000000,"zh":"中國"},{"name":"CH","val":1871000000,"zh":"CH"},{"name":"IN","val":1871000000,"zh":"印度"},{"name":"JP","val":1475000000,"zh":"日本"},{"name":"GB","val":1340000000,"zh":"英國"}],"total":44328000000}},"peers":["ABBV","BMY","JNJ","MDT","LLY"]}}