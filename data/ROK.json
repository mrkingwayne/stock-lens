D Business) to The Boeing Company (Boeing). In the reorganization, RIC contributed all of its businesses, other than the A&D Business, to the Company and distributed all capital stock of the Company to RIC's shareowners. Boeing then acquired RIC.","zh":null}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2026-09-30","items":[{"name":"Intelligent Devices","val":4185000000,"zh":"Intelligent Devices"},{"name":"Software & Control","val":2818000000,"zh":"Software & Control"},{"name":"Lifecycle Services","val":2071000000,"zh":"Lifecycle Services"}],"total":8989000000},"prod":{"end":"2026-09-30","items":[{"name":"Productsand Solutions","val":8018000000,"zh":"Productsand Solutions"},{"name":"Service","val":971000000,"zh":"服務"}],"total":8989000000},"geo":{"end":"2026-09-30","items":[{"name":"North America","val":5801000000,"zh":"North America"},{"name":"US","val":5381000000,"zh":"美國"},{"name":"EMEA","val":1603000000,"zh":"EMEA"},{"name":"Asia Pacific","val":1108000000,"zh":"亞太"},{"name":"Latin America","val":562000000,"zh":"Latin America"}],"total":8989000000}},"peers":["PH","ETN","ROP","TER","ITW"]}}