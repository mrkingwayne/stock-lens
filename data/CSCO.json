m5LREpZa29XYzJQcE1laXdvczVIMTFwc3FtRFU3VEtRdUhjMXJMVFpIM3pTR09reFdmREdLSGZ0QjRFZDdzNV85cFRU?oc=5","date":"2026-10-21","zh":"Sawyer & Company Inc 對思科系統公司進行新投資 $CSCO"}],"themes":[{"name":"AI 人工智慧","count":4},{"name":"財報","count":1},{"name":"訂單/合約","count":1}],"biz":{"tenk":{"form":"10-K","date":"2026-09-02","period":"2026-07-25","url":"https://www.sec.gov/Archives/edgar/data/858877/000085887726000132/csco-20260725.htm"},"overview":[{"en":"Cisco designs and sells a broad range of technologies including hardware, software, and artificial intelligence (AI) powered digital infrastructure to power, help secure, and draw insights from the Internet. We are incorporating AI into our product portfolios across networking, security, collaboration and observability, as well as integrating our products more tightly together into a platform. We are simplifying how our technology is delivered, managed and optimized and helping customers maximize the business value of their technology investments.","zh":null},{"en":"We conduct our business globally and manage our business by geography. Our business is organized into the following three geographic segments: Americas; Europe, Middle East, and Africa (EMEA); and Asia Pacific, Japan, and China (APJC).","zh":null},{"en":"Our products and technologies are grouped into the following categories: Networking, Security, Collaboration and Observability. In addition to our product offerings, we provide a broad range of services over the lifecycle of our products, including technical support services and professional services. Our customers include businesses of all sizes, public institutions, governments, and service providers, including hyperscalers. These customers often look to us as a strategic partner to help them use technology to differentiate themselves and drive positive business outcomes.","zh":null}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2026-07-25","items":[{"name":"Americas","val":37799000000,"zh":"美洲"},{"name":"Europe Middle East & Africa","val":16613000000,"zh":"Europe Middle East & Africa"},{"name":"Asia Pacific Japan & China","val":8914000000,"zh":"Asia Pacific Japan & China"}],"total":63325000000},"prod":{"end":"2026-07-25","items":[{"name":"Networking","val":34668000000,"zh":"網通"},{"name":"Subscription & Circulation","val":31977000000,"zh":"Subscription & Circulation"},{"name":"Subscription Revenue Product","val":18314000000,"zh":"Subscription Revenue Product"},{"name":"Service","val":15030000000,"zh":"服務"},{"name":"Subscription Revenue Service","val":13663000000,"zh":"Subscription Revenue Service"},{"name":"Security","val":8232000000,"zh":"Security"},{"name":"Collaboration","val":4300000000,"zh":"Collaboration"},{"name":"Observability","val":1095000000,"zh":"Observability"}],"total":63325000000}},"peers":["ORCL","INTC","IBM","QCOM","PFE"]}}