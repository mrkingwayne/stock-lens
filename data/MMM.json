he Exchange Act as soon as reasonably practicable after the Company electronically files such material with, or furnishes it to, the SEC.","zh":"3M 也透過其網站 (https://investors.3M.com) 免費提供公司的 10-K 表年度報告、10-Q 表季度報告、8-K 表當前報告，以及公司以電子方式向 SEC 提交或提供此類資料後，盡快根據《交易法》提交或提供的報告的修訂（如果適用）。"}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2025-12-31","items":[{"name":"Safety & Industrial","val":11384000000,"zh":"安全與工業部門"},{"name":"Transportation & Electronics","val":8272000000,"zh":"交通及電子部門"},{"name":"Consumer","val":4920000000,"zh":"消費部門"}],"total":24948000000},"geo":{"end":"2025-12-31","items":[{"name":"Americas","val":13579000000,"zh":"美洲"},{"name":"US","val":10936000000,"zh":"美國"},{"name":"Asia Pacific","val":7095000000,"zh":"亞太"},{"name":"EMEA","val":4274000000,"zh":"歐洲、中東和非洲地區"},{"name":"China & Hong Kong","val":2951000000,"zh":"中國及香港"}],"total":24948000000}},"peers":["JNJ","CAT","PG","HON","PEP"]}}