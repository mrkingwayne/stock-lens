0X09xUWtyLWdGQnNsQlR2LUttVW92TnF3TkVCbUQ0QnhUYWoyWnYyaV9id3Fka0I0WDh3czV4VkpmdTIyX18wXy0tbzU1LXpiSm8zSXBQQkRrUHA2NmxMY2hDS2ZSUDVWMWxDUEl4cXpSVk1Pemx5R0lWSHdJM0FPMjVB?oc=5","date":"2026-11-05","zh":"Expedia Group（納斯達克股票代碼：EXPE）是否上調了 2026 年指引，調整後每股收益為 9.39 美元？"}],"themes":[{"name":"財報","count":6},{"name":"分析師評等","count":4},{"name":"訂單/合約","count":2}],"biz":{"tenk":{"form":"10-K","date":"2026-02-13","period":"2025-12-31","url":"https://www.sec.gov/Archives/edgar/data/1324424/000132442426000008/expe-20251231.htm"},"overview":[{"en":"Expedia Group, Inc. is the global travel marketplace with one purpose: to help travelers explore the world, one journey at a time. We connect travelers, partners, and advertisers throughout our trusted brands, leading technology, and rich first-party data, delivering predictive, personalized experiences that shape the future of travel. We leverage our supply portfolio, platform and technology capabilities across an extensive portfolio of consumer brands, and provide solutions to our business partners, to empower travelers to efficiently research, plan, book and experience travel.","zh":"Expedia Group, Inc. 是一家全球旅遊市場，其宗旨只有一個：幫助旅客探索世界，一次完成一次旅程。我們透過值得信賴的品牌、領先的技術和豐富的第一方數據將旅客、合作夥伴和廣告商聯繫起來，提供可預測的個人化體驗，塑造旅行的未來。我們利用我們在廣泛的消費品牌組合中的供應組合、平台和技術能力，為我們的業務合作夥伴提供解決方案，使旅行者能夠有效地研究、規劃、預訂和體驗旅行。"},{"en":"At the end of 2025, we had approximately 3.6 million lodging properties available, including approximately 2.4 million online bookable alternative accommodations through Vrbo, approximately 1.2 million hotels and alternative accommodations through our other brands, over 500 airlines, packages, rental cars, cruises, insurance, as well as activities and experiences.","zh":"截至 2025 年底，我們擁有約 360 萬家可用住宿，其中包括約 240 萬家透過 Vrbo 在線預訂的替代住宿、約 120 萬家酒店和透過我們其他品牌提供的替代住宿、超過 500 家航空公司、套餐、租車、遊輪、保險以及活動和體驗。"},{"en":"Travel suppliers distribute and market products via our apps, desktop and mobile offerings, as well as through alternative distribution channels, our business partnerships and our call centers in order to reach our extensive global audience. In addition, our advertising and media businesses help other businesses, primarily travel providers, reach a large multi-platform audience of travelers around the globe.","zh":"旅遊供應商透過我們的應用程式、桌面和行動產品以及其他分銷管道、我們的業務合作夥伴和呼叫中心分銷和行銷產品，以便覆蓋我們廣泛的全球受眾。此外，我們的廣告和媒體業務幫助其他企業（主要是旅遊提供者）接觸全球大量多平台旅客受眾。"}],"markets":[],"customers":[],"competition":[],"segments":{"seg":{"end":"2025-12-31","items":[{"name":"B2C","val":9474000000,"zh":"企業對消費者"},{"name":"Business To Business","val":4842000000,"zh":"企業對企業"},{"name":"Trivago","val":622000000,"zh":"特里瓦戈"}],"total":14733000000},"prod":{"end":"2025-12-31","items":[{"name":"Lodging","val":11752000000,"zh":"住宿"},{"name":"Other Services","val":1399000000,"zh":"其他服務"},{"name":"EG Advertising","val":758000000,"zh":"EG廣告"},{"name":"Trivago Advertising","val":417000000,"zh":"Trivago 廣告"},{"name":"Air","val":407000000,"zh":"空氣"}],"total":14733000000},"geo":{"end":"2025-12-31","items":[{"name":"US","val":8710000000,"zh":"美國"},{"name":"Non Us","val":6023000000,"zh":"非我們"}],"total":14733000000}},"peers":["BKNG","TRIP","MAR","WYNN","HLT"]}}